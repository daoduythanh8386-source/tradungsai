{
  "name": "tradungsai",
  "version": "1.0.0",
  "description": "Tra cứu dung sai Oristar - TQM.QĐ02-03",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build:exe": "electron-builder --win",
    "build:apk": "npx cap sync && npx cap build android",
    "build:all": "npm run build:exe && npm run build:apk"
  },
  "dependencies": {
    "@capacitor/core": "^6.1.2"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/android": "^6.1.2"
  },
  "build": {
    "appId": "com.tradungsai.app",
    "productName": "TraDungSai",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "www/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "www/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
